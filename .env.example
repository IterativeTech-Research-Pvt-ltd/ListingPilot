# ==============================================================================
# ListingPilot Unified Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your values
# ==============================================================================

# ------------------------------------------------------------------------------
# Project & Server Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="ListingPilot"
API_V1_STR="/api/v1"
PORT=8000
HOST="127.0.0.1"
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# ------------------------------------------------------------------------------
# Database Configuration (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Supabase dashboard -> Connect. The direct host (db.<ref>.supabase.co) is IPv6-only; on an
# IPv4-only network use the "Session pooler" string (user postgres.<ref>, host aws-0-<region>.pooler.supabase.com).
DATABASE_URL="postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres"
# Tests only: a SEPARATE database, e.g. run CREATE DATABASE listingpilot_test on the same instance.
# Never the same as DATABASE_URL: every test run drops and recreates its tables.
TEST_DATABASE_URL="postgresql://postgres:password@db.your-project-ref.supabase.co:5432/listingpilot_test"

# ------------------------------------------------------------------------------
# Brand Default
# ------------------------------------------------------------------------------
DEFAULT_BRAND="Gulmohar Home"

# ------------------------------------------------------------------------------
# AI Listing Generation (OpenRouter / Claude API)
# ------------------------------------------------------------------------------
AI_PROVIDER="openrouter"

# OpenRouter (Supports free/low-cost models):
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_MODEL="nvidia/nemotron-3.5-lightning:free"

# Groq (direct, free tier available): set AI_PROVIDER="groq"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# Anthropic Claude API (Direct alternative):
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-3-5-sonnet-20241022"

# ------------------------------------------------------------------------------
# Redis & Background Workers (Optional)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# ------------------------------------------------------------------------------
# Amazon Selling Partner API (SP-API) - Optional (runs in stub mode if omitted)
# ------------------------------------------------------------------------------
AMAZON_SELLER_ID=""
AMAZON_MARKETPLACE_ID="A21TJRUUN4KGV"
AMAZON_SP_API_CLIENT_ID=""
AMAZON_SP_API_CLIENT_SECRET=""
AMAZON_SP_API_REFRESH_TOKEN=""
AMAZON_AWS_ACCESS_KEY=""
AMAZON_AWS_SECRET_KEY=""
AMAZON_AWS_ROLE_ARN=""

# ------------------------------------------------------------------------------
# Flipkart Seller API - Optional (runs in stub mode if omitted)
# ------------------------------------------------------------------------------
FLIPKART_APP_ID=""
FLIPKART_APP_SECRET=""

# ------------------------------------------------------------------------------
# Frontend Settings (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE="http://127.0.0.1:8000/api/v1"
