# ==============================================================================
# ListingPilot Comprehensive .gitignore
# ==============================================================================

# --- Environment & Secret Configuration ---
.env
.env.*
*.env
!*.env.example
!.env.example
secrets/
*.pem
*.key
*.cert

# --- Local Databases & SQLite Caches ---
*.db
*.sqlite
*.sqlite3
*.db-journal
test_pilot.db

# --- Python & Virtual Environments ---
.venv/
venv/
env/
ENV/
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
*.pyd

# --- Pytest & Test Artifacts ---
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# --- Node, Next.js & Package Managers ---
node_modules/
*/node_modules/
.pnpm-store/
*/.pnpm-store/
.next/
*/.next/
out/
build/
dist/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Runtime Uploads & Generated Temp Files ---
backend/uploads/*
!backend/uploads/.gitkeep
scratch_*.py
temp_*.xlsx
temp_*.csv
ListingPilot_*.xlsx
ListingPilot_*.zip
*.log

# --- OS & Editor Cache ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
